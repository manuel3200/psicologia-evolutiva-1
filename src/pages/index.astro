---
import '../styles/global.css';
import recursosData from '../data/recursos/index.json';

const driveTitulo = recursosData.drivePrincipalTitulo || "Drive Oficial de Psicología Evolutiva 1";
const driveMensaje = recursosData.drivePrincipalMensaje || "Este es el Drive donde se encuentran los recursos para la materia.";
const driveDescripcion = recursosData.drivePrincipalDescripcion || "Accedé a toda la carpeta compartida en la nube con textos obligatorios, programas de cátedra, diapositivas y guías de estudio organizadas por la cátedra.";
const driveUrl = recursosData.drivePrincipalUrl || "https://drive.google.com";
const enlaces = recursosData.enlacesAdicionales || [];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Portal oficial de la Cátedra de Psicología Evolutiva 1. Repositorio en Google Drive y herramientas de autoevaluación." />
  <title>Psicología Evolutiva 1 | Portal Académico</title>
</head>
<body>

  <!-- CABECERA -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">
        <div class="brand-icon">🌱</div>
        <div class="brand-info">
          <span class="brand-title">Psicología Evolutiva 1</span>
          <span class="brand-sub">Portal Jamstack con Keystatic CMS</span>
        </div>
      </a>

      <nav class="main-nav">
        <a href="/" class="nav-link active">Inicio</a>
        <a href="#recursos" class="nav-link">📁 Recursos & Drive</a>
        <a href="/autoevaluacion" class="nav-link">📊 Analizador Excel</a>
        <a href="/docentes" class="nav-link nav-link-teacher">📖 Instructivo Docente</a>
        <a href="/keystatic" class="nav-link nav-link-cms" title="Panel CMS para editar contenidos">✏️ Admin Keystatic</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        <span>🎓 Ciclo Lectivo 2026</span>
        <span>•</span>
        <span>Carrera de Psicología / Psicopedagogía</span>
      </div>
      <h1 class="hero-title">Cátedra de Psicología Evolutiva 1</h1>
      <p class="hero-lead">
        Estudio comprensivo de las transformaciones psicológicas del ser humano a lo largo del ciclo vital: 
        desde la vida prenatal, la primera infancia y la niñez, articulando las dimensiones cognitivas, 
        afectivas y socio-culturales.
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="#recursos" class="btn btn-primary">
          <span>📂</span> Ir al Drive de Recursos
        </a>
        <a href="/autoevaluacion" class="btn btn-teacher">
          <span>📊</span> Analizador de Autoevaluaciones
        </a>
        <a href="/docentes" class="btn btn-outline-white">
          <span>📖</span> Instructivo Docente
        </a>
        <a href="/keystatic" class="btn btn-outline-white">
          <span>✏️</span> Keystatic CMS
        </a>
      </div>
    </div>
  </section>

  <!-- SECCIÓN PRINCIPAL: VENTANA CENTRAL DE GOOGLE DRIVE -->
  <section id="recursos" class="section" style="padding-top: 0;">
    <div class="container">
      
      <!-- VENTANA CENTRAL DE DRIVE -->
      <div class="drive-window">
        <div class="drive-window-info">
          <div class="drive-tag">
            <span>📁 Repositorio Central Oficial</span>
          </div>
          <h2>{driveTitulo}</h2>
          <p style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin-bottom: 0.5rem;">
            {driveMensaje}
          </p>
          <p>
            {driveDescripcion}
          </p>
        </div>
        <div>
          <a href={driveUrl} target="_blank" rel="noopener noreferrer" class="btn drive-btn">
            <span>🚀</span> Abrir Carpeta en Google Drive ↗
          </a>
        </div>
      </div>

      <!-- SECCIÓN DINÁMICA DE ENLACES ADICIONALES (CONFIGURADOS EN KEYSTATIC) -->
      <div class="section-header" style="margin-top: 1rem;">
        <span class="section-tag">Administrado con Keystatic CMS</span>
        <h2 class="section-title">Apartados Especiales de Estudio</h2>
        <p class="section-desc">
          Materiales complementarios, carpetas temáticas y guías agregadas por el equipo docente a través del CMS.
        </p>
      </div>

      <!-- GRID DE ENLACES DINÁMICOS -->
      <div class="links-grid">
        {enlaces.length === 0 ? (
          <div style="grid-column: 1 / -1; background: #ffffff; padding: 2rem; border-radius: 12px; border: 1px dashed var(--border-strong); text-align: center; color: var(--text-muted);">
            <p>No hay apartados adicionales configurados en este momento. El material principal se encuentra en la ventana de Drive superior.</p>
          </div>
        ) : (
          enlaces.map((item) => (
            <div class="link-card">
              <div class="link-icon">🔗</div>
              <h3 class="link-title">{item.titulo}</h3>
              <p class="link-desc">{item.descripcion || 'Acceso directo a los materiales vinculados a este apartado.'}</p>
              <div class="link-url-preview">{item.url}</div>
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" style="margin-top: auto;">
                Abrir Recurso ↗
              </a>
            </div>
          ))
        )}
      </div>

      <!-- BANNER DE GESTIÓN DOCENTE -->
      <div class="teacher-hub-card">
        <div>
          <span style="font-size: 0.8rem; text-transform: uppercase; font-weight: 700; background: rgba(255,255,255,0.2); padding: 3px 10px; border-radius: 20px; display: inline-block; margin-bottom: 8px;">
            Área Exclusiva para Docentes
          </span>
          <h3>¿Sos docente de la cátedra?</h3>
          <p>
            Accedé a la herramienta de autoevaluaciones con el tutorial para procesar el archivo Excel de Google Forms, 
            o ingresá al CMS de Keystatic para añadir nuevos enlaces o cambiar la URL de Drive sin tocar código.
          </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/autoevaluacion" class="btn btn-outline-white" style="background: #ffffff; color: #b45309; font-weight: 800;">
            <span>📊</span> Abrir Analizador
          </a>
          <a href="/docentes" class="btn btn-outline-white">
            <span>📖</span> Tutorial Excel
          </a>
          <a href="/keystatic" class="btn btn-outline-white">
            <span>✏️</span> Abrir Keystatic CMS
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- PIE DE PÁGINA -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-inner">
        <div>
          <div style="font-weight: 700; color: #ffffff; font-size: 1.1rem; margin-bottom: 4px;">Cátedra de Psicología Evolutiva 1</div>
          <p style="font-size: 0.88rem; color: #94a3b8; max-width: 460px;">
            Arquitectura Jamstack (Astro + Keystatic Headless CMS) desplegada en Cloudflare Pages.
          </p>
        </div>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <a href="/" style="color: #cbd5e1; font-size: 0.9rem;">Inicio</a>
          <a href="#recursos" style="color: #cbd5e1; font-size: 0.9rem;">Recursos Drive</a>
          <a href="/autoevaluacion" style="color: #cbd5e1; font-size: 0.9rem;">Analizador</a>
          <a href="/docentes" style="color: #cbd5e1; font-size: 0.9rem;">Portal Docente</a>
          <a href="/keystatic" style="color: #cbd5e1; font-size: 0.9rem;">Admin Keystatic</a>
        </div>
      </div>
      <div class="footer-copy">
        © 2026 Cátedra de Psicología Evolutiva 1. Jamstack 100% gratuito.
      </div>
    </div>
  </footer>

</body>
</html>
